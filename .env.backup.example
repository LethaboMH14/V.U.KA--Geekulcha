# Settings for a BACKUP ANCHOR server (not the team's official Azure server).
# Copy is made for you by:  python scripts/make-backup-keys.py   → .env.backup (gitignored)
# Never commit .env.backup or paste it into chat.

# ── Database ──
# docker-compose sets DATABASE_URL itself from POSTGRES_PASSWORD.
# On Render/Koyeb/Cloud Run, use a Neon connection string instead, e.g.
# postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/vuka?sslmode=require
POSTGRES_PASSWORD=
DATABASE_URL=

# ── Keys (generated) ──
VUKA_PAYLOAD_KEY_B64=
VUKA_SERVER_ED25519_KEY_B64=
VUKA_BACKUP_MANIFEST_JSON=

# ── Email codes (any SMTP account; Gmail: an "app password", port 587) ──
VUKA_SMTP_HOST=
VUKA_SMTP_PORT=587
VUKA_SMTP_USER=
VUKA_SMTP_PASSWORD=
VUKA_SMTP_FROM=

# ── SMS codes (optional; Twilio trial works for verified numbers) ──
VUKA_TWILIO_ACCOUNT_SID=
VUKA_TWILIO_AUTH_TOKEN=
VUKA_TWILIO_FROM=

# ── Push to guardians (optional; Firebase Cloud Messaging) ──
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=

# ── Behaviour ──
VUKA_CONTACT_LOST_ENABLED=0
# Only for a test server with no email/SMS provider: print codes in the server log.
# Leave 0 on anything a real person can reach.
VUKA_DEV_OTP_LOG=0
