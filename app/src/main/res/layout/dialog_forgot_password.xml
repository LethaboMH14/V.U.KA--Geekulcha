<?xml version="1.0" encoding="utf-8"?>
<!-- Forgot password: email → code to the recovery contact → new password. Same fields as the forms. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_handle_bar" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="Reset your password"
                android:textColor="@color/vuka_text_title"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_close_button"
                android:contentDescription="Close"
                android:padding="9dp"
                android:src="@drawable/ic_x"
                app:tint="@color/vuka_text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="2dp"
            android:text="Enter the email you sign in with. We'll send a code to the recovery contact you chose in Settings."
            android:textColor="@color/vuka_text_secondary"
            android:textSize="14sp" />

        <!-- Step 1: which account -->
        <LinearLayout
            android:id="@+id/stepEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.Vuka.FieldLabel"
                android:layout_marginTop="16dp"
                android:labelFor="@id/etEmail"
                android:text="Email" />

            <EditText
                android:id="@+id/etEmail"
                style="@style/Widget.Vuka.TextField"
                android:autofillHints="emailAddress"
                android:hint="you@example.co.za"
                android:inputType="textEmailAddress" />
        </LinearLayout>

        <!-- Step 2: code and new password -->
        <LinearLayout
            android:id="@+id/stepReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="CODE SENT BY VUKA'S SERVER · VALID FOR 10 MINUTES"
                android:textColor="@color/vuka_text_dim"
                android:textSize="10sp" />

            <TextView
                style="@style/Widget.Vuka.FieldLabel"
                android:layout_marginTop="16dp"
                android:labelFor="@id/etCode"
                android:text="6-digit code" />

            <EditText
                android:id="@+id/etCode"
                style="@style/Widget.Vuka.TextField"
                android:autofillHints="smsOTPCode"
                android:fontFamily="monospace"
                android:inputType="number"
                android:maxLength="6" />

            <TextView
                style="@style/Widget.Vuka.FieldLabel"
                android:layout_marginTop="16dp"
                android:labelFor="@id/etPassword"
                android:text="New password" />

            <EditText
                android:id="@+id/etPassword"
                style="@style/Widget.Vuka.TextField"
                android:autofillHints="newPassword"
                android:inputType="textPassword" />

            <TextView
                style="@style/Widget.Vuka.FieldLabel"
                android:layout_marginTop="16dp"
                android:labelFor="@id/etConfirm"
                android:text="Confirm new password" />

            <EditText
                android:id="@+id/etConfirm"
                style="@style/Widget.Vuka.TextField"
                android:autofillHints="newPassword"
                android:inputType="textPassword" />
        </LinearLayout>

        <!-- InlineError: ink outline + icon, never a red border -->
        <LinearLayout
            android:id="@+id/errorContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_input_field_error"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_warning_circle"
                app:tint="@color/vuka_text_title" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/vuka_text_label"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrimary"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_primary"
            app:backgroundTint="@null"
            android:text="Send code"
            android:textAllCaps="false"
            android:textColor="@color/vuka_text_inverse"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="27dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="2dp"
            android:text="Forgotten your PIN instead? It can only be recovered with your recovery code, not by email or text."
            android:textColor="@color/vuka_text_dim"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
