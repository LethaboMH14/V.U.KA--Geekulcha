<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/vukaBgBase"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp">

        <!-- Identity row with the prototype's own SIMULATED chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_back_button"
                android:contentDescription="Back to standby"
                android:padding="13dp"
                android:src="@drawable/ic_caret_left"
                app:tint="@color/vuka_text_secondary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:letterSpacing="0.06"
                android:text="GUARDIAN · ALERT"
                android:textColor="@color/vuka_text_title"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Widget.Vuka.StatusChip.Simulated"
                android:text="Simulated" />
        </LinearLayout>

        <!-- Amber lead card: the one urgent colour -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_amber_card"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_prohibit"
                app:tint="@color/vuka_amber_text" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:letterSpacing="-0.01"
                android:text="Don't call or text them. Call 10111."
                android:textColor="@color/vuka_amber_text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Who and why -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="WHO"
                android:textColor="@color/vuka_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Example member"
                android:textColor="@color/vuka_text_title"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="?attr/vukaBorder" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="WHY"
                android:textColor="@color/vuka_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="Scream-like sound, then no answer in 60 s"
                android:textColor="@color/vuka_text_label"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Location -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_glass_card"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_icon">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:alpha="0.85"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_map_pin"
                    app:tint="@color/vuka_text_title" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Location unavailable"
                    android:textColor="@color/vuka_text_label"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="3dp"
                    android:text="No location fix was shared for this detection."
                    android:textColor="@color/vuka_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <!-- ── Actions: new → called → handling → stood down ── -->

        <!-- The prototype colours this line green and says "signed". Nothing is
             signed yet and green is reserved for real verification. -->
        <LinearLayout
            android:id="@+id/statusLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingTop="4dp"
            android:paddingEnd="2dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_seal_check"
                app:tint="@color/vuka_text_secondary" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="@color/vuka_text_label"
                android:textSize="14sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrimary"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_button_primary"
            app:backgroundTint="@null"
            android:textAllCaps="false"
            android:textColor="@color/vuka_text_inverse"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="27dp"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconTint="@color/vuka_text_inverse" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStandDown"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="@color/vuka_card_solid"
            android:text="Stand down"
            android:textAllCaps="false"
            android:textColor="@color/vuka_text_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="27dp"
            app:strokeColor="?attr/vukaBorder"
            app:strokeWidth="1dp" />

        <TextView
            android:id="@+id/tvPreviewNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Preview: this doesn't open the phone's dialer."
            android:textColor="@color/vuka_text_dim"
            android:textSize="12sp" />

        <!-- Locked during an open incident (spec G4); unlocks after stand-down -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCallThem"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:alpha="0.4"
            android:enabled="false"
            android:text="Call them"
            android:textAllCaps="false"
            android:textColor="@color/vuka_text_secondary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="27dp"
            app:icon="@drawable/ic_phone_x"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconTint="@color/vuka_text_secondary"
            app:strokeColor="?attr/vukaBorder"
            app:strokeWidth="1dp" />

        <TextView
            android:id="@+id/tvCallLock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="Their phone ringing could put them in more danger, so calling them unlocks after stand-down or when the incident closes. You can still use your phone for anything else, like reaching family."
            android:textColor="@color/vuka_text_dim"
            android:textSize="12sp" />

        <!-- Not in the prototype: links this preview to the Acknowledged timeline -->
        <TextView
            android:id="@+id/linkTimeline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="See the timeline"
            android:textColor="@color/vuka_link"
            android:textSize="14sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToStandby"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/vuka_card_solid"
            android:text="Back to standby"
            android:textAllCaps="false"
            android:textColor="@color/vuka_text_title"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="27dp"
            app:strokeColor="?attr/vukaBorder"
            app:strokeWidth="1dp" />
    </LinearLayout>
</ScrollView>
