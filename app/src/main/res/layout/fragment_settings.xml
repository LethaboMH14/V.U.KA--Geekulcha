<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/vukaBgBase"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="VUKA"
            android:textColor="@color/vuka_text_dim"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:accessibilityHeading="true"
            android:text="Settings"
            android:textColor="@color/vuka_text_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Profile -->
        <LinearLayout
            style="@style/Widget.Vuka.SettingsSection"
            android:layout_marginTop="20dp">

            <TextView
                style="@style/Widget.Vuka.SettingsSectionTitle"
                android:text="Profile" />

            <LinearLayout
                android:id="@+id/profileRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_subtle"
                android:orientation="vertical"
                android:showDividers="middle" />
        </LinearLayout>

        <!-- Guardians -->
        <LinearLayout style="@style/Widget.Vuka.SettingsSection">

            <TextView
                style="@style/Widget.Vuka.SettingsSectionTitle"
                android:text="Guardians" />

            <LinearLayout
                android:id="@+id/guardianRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_subtle"
                android:orientation="vertical"
                android:showDividers="middle" />
        </LinearLayout>

        <!-- Guardian for others: a member can also protect someone -->
        <LinearLayout style="@style/Widget.Vuka.SettingsSection">

            <TextView
                style="@style/Widget.Vuka.SettingsSectionTitle"
                android:text="Guardian for others" />

            <LinearLayout
                android:id="@+id/guardianRoleRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Appearance -->
        <LinearLayout style="@style/Widget.Vuka.SettingsSection">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_palette"
                    app:tint="@color/vuka_text_dim" />

                <TextView
                    style="@style/Widget.Vuka.SettingsSectionTitle"
                    android:layout_marginBottom="0dp"
                    android:text="Appearance" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Theme"
                android:textColor="@color/vuka_text_dim"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/themeOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/themeIvory"
                    style="@style/Widget.Vuka.SegmentOption"
                    android:layout_marginEnd="4dp"
                    android:text="Ivory" />

                <TextView
                    android:id="@+id/themeSilver"
                    style="@style/Widget.Vuka.SegmentOption"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:text="Silver" />

                <TextView
                    android:id="@+id/themeMidnight"
                    style="@style/Widget.Vuka.SegmentOption"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:text="Midnight" />

                <TextView
                    android:id="@+id/themeSystem"
                    style="@style/Widget.Vuka.SegmentOption"
                    android:layout_marginStart="4dp"
                    android:text="System" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"
                android:text="System follows your phone's dark theme setting."
                android:textColor="@color/vuka_text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Documents and your rights -->
        <LinearLayout style="@style/Widget.Vuka.SettingsSection">

            <TextView
                style="@style/Widget.Vuka.SettingsSectionTitle"
                android:text="Documents and your rights" />

            <LinearLayout
                android:id="@+id/documentRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_subtle"
                android:orientation="vertical"
                android:showDividers="middle" />
        </LinearLayout>

        <!-- Privacy and data -->
        <LinearLayout style="@style/Widget.Vuka.SettingsSection">

            <TextView
                style="@style/Widget.Vuka.SettingsSectionTitle"
                android:text="Privacy and data" />

            <LinearLayout
                android:id="@+id/dataRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_subtle"
                android:orientation="vertical"
                android:showDividers="middle" />
        </LinearLayout>

        <!-- Account: signing out weakens protection, so it needs the PIN -->
        <LinearLayout style="@style/Widget.Vuka.SettingsSection">

            <TextView
                style="@style/Widget.Vuka.SettingsSectionTitle"
                android:text="Account" />

            <LinearLayout
                android:id="@+id/accountRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
