<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/vukaBgBase"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_back_button"
                android:contentDescription="Back"
                android:padding="13dp"
                android:src="@drawable/ic_caret_left"
                app:tint="@color/vuka_text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="STEP 7 OF 8"
                    android:textColor="@color/vuka_text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStepTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:accessibilityHeading="true"
                    android:text="Set your PINs"
                    android:textColor="@color/vuka_text_title"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── PIN stages: normal ×2, then duress ×2 ── -->
        <LinearLayout
            android:id="@+id/pinStage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_icon">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:alpha="0.85"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/vuka_text_title" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvStageTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:accessibilityLiveRegion="polite"
                        android:letterSpacing="0.1"
                        android:textAllCaps="true"
                        android:textColor="@color/vuka_text_dim"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStageBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/vuka_text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- InlineError from shared.tsx: ink outline + icon, never a red border -->
            <LinearLayout
                android:id="@+id/errorContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_input_field_error"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="1dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_warning_circle"
                    app:tint="@color/vuka_text_title" />

                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/vuka_text_label"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pinDots"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="30dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View style="@style/Widget.Vuka.PinDot" />
                <View style="@style/Widget.Vuka.PinDot" />
                <View style="@style/Widget.Vuka.PinDot" />
                <View style="@style/Widget.Vuka.PinDot" />
            </LinearLayout>

            <GridLayout
                android:id="@+id/keypad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-4dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="-4dp"
                android:columnCount="3">

                <TextView style="@style/Widget.Vuka.KeypadKey.Pin" android:text="1" />
                <TextView style="@style/Widget.Vuka.KeypadKey.Pin" android:text="2" />
                <TextView style="@style/Widget.Vuka.KeypadKey.Pin" android:text="3" />
                <TextView style="@style/Widget.Vuka.KeypadKey.Pin" android:text="4" />
                <TextView style="@style/Widget.Vuka.KeypadKey.Pin" android:text="5" />
                <TextView style="@style/Widget.Vuka.KeypadKey.Pin" android:text="6" />
                <TextView style="@style/Widget.Vuka.KeypadKey.Pin" android:text="7" />
                <TextView style="@style/Widget.Vuka.KeypadKey.Pin" android:text="8" />
                <TextView style="@style/Widget.Vuka.KeypadKey.Pin" android:text="9" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp" />

                <TextView style="@style/Widget.Vuka.KeypadKey.Pin" android:text="0" />

                <ImageView
                    android:id="@+id/keyDelete"
                    style="@style/Widget.Vuka.KeypadKey.Pin"
                    android:contentDescription="Delete"
                    android:padding="17dp"
                    android:src="@drawable/ic_backspace"
                    app:tint="@color/vuka_text_secondary" />
            </GridLayout>
        </LinearLayout>

        <!-- ── Recovery stage. Recovery is on the cut line (COERCION-SCENARIOS
             D07): with it cut, no code is shown. ── -->
        <LinearLayout
            android:id="@+id/recoveryStage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_shield_warning"
                        app:tint="@color/vuka_text_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Recovery codes"
                        android:textColor="@color/vuka_text_title"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Widget.Vuka.StatusChip.Simulated"
                        android:text="Proposed" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Recovery codes aren't available in this build yet."
                    android:textColor="@color/vuka_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinue"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_button_primary"
                app:backgroundTint="@null"
                android:text="Continue"
                android:textAllCaps="false"
                android:textColor="@color/vuka_text_inverse"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="27dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
