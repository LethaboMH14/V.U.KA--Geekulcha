<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/vukaBgBase"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_back_button"
                android:contentDescription="Back"
                android:padding="13dp"
                android:src="@drawable/ic_caret_left"
                app:tint="@color/vuka_text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:textColor="@color/vuka_text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:accessibilityHeading="true"
                    android:textColor="@color/vuka_text_title"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Stage 1: invite code ── -->
        <LinearLayout
            android:id="@+id/stageCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:text="Enter the invite code someone shared with you, or scan it."
                    android:textColor="@color/vuka_text_secondary"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:text="SIMULATED · CODES AREN'T CHECKED · ANY 6 DIGITS CONTINUE"
                    android:textColor="@color/vuka_text_dim"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabCode"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:text="Enter code"
                    android:textColor="@color/vuka_text_label"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_keyboard"
                    app:drawableTint="@color/vuka_text_label" />

                <TextView
                    android:id="@+id/tabScan"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:text="Scan QR"
                    android:textColor="@color/vuka_text_label"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_qr_code"
                    app:drawableTint="@color/vuka_text_label" />
            </LinearLayout>

            <!-- Enter code -->
            <LinearLayout
                android:id="@+id/methodCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/codeBoxes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="8dp"
                    android:accessibilityLiveRegion="polite"
                    android:focusable="true"
                    android:orientation="horizontal">

                    <TextView style="@style/Widget.Vuka.CodeBox" />
                    <TextView style="@style/Widget.Vuka.CodeBox" />
                    <TextView style="@style/Widget.Vuka.CodeBox" />
                    <TextView style="@style/Widget.Vuka.CodeBox" />
                    <TextView style="@style/Widget.Vuka.CodeBox" />
                    <TextView style="@style/Widget.Vuka.CodeBox" />
                </LinearLayout>

                <GridLayout
                    android:id="@+id/keypad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-4dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="-4dp"
                    android:columnCount="3">

                    <TextView style="@style/Widget.Vuka.KeypadKey" android:text="1" />
                    <TextView style="@style/Widget.Vuka.KeypadKey" android:text="2" />
                    <TextView style="@style/Widget.Vuka.KeypadKey" android:text="3" />
                    <TextView style="@style/Widget.Vuka.KeypadKey" android:text="4" />
                    <TextView style="@style/Widget.Vuka.KeypadKey" android:text="5" />
                    <TextView style="@style/Widget.Vuka.KeypadKey" android:text="6" />
                    <TextView style="@style/Widget.Vuka.KeypadKey" android:text="7" />
                    <TextView style="@style/Widget.Vuka.KeypadKey" android:text="8" />
                    <TextView style="@style/Widget.Vuka.KeypadKey" android:text="9" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp" />

                    <TextView style="@style/Widget.Vuka.KeypadKey" android:text="0" />

                    <ImageView
                        android:id="@+id/keyDelete"
                        style="@style/Widget.Vuka.KeypadKey"
                        android:contentDescription="Delete"
                        android:padding="15dp"
                        android:src="@drawable/ic_backspace"
                        app:tint="@color/vuka_text_title" />
                </GridLayout>
            </LinearLayout>

            <!-- Scan QR: ScannerFrame placeholder. No camera is opened. -->
            <FrameLayout
                android:id="@+id/methodScan"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_scanner_frame"
                android:visibility="gone">

                <ImageView
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_scanner_corners" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:text="SIMULATED CAMERA"
                    android:textColor="@color/vuka_text_dim"
                    android:textSize="11sp" />
            </FrameLayout>
        </LinearLayout>

        <!-- ── Stage 2: consent ── -->
        <LinearLayout
            android:id="@+id/stageConsent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="WHAT IS RECORDED ABOUT YOU"
                    android:textColor="@color/vuka_text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="When you open an alert, and how you respond. Nothing else about you is recorded as a guardian."
                    android:textColor="@color/vuka_text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbUnderstood"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="48dp"
                android:paddingStart="6dp"
                android:text="I understand what's recorded about me as a guardian."
                android:textColor="@color/vuka_text_label"
                android:textSize="14sp"
                app:buttonTint="@color/vuka_text_title" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUnderstand"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_button_primary"
                app:backgroundTint="@null"
                android:text="I understand"
                android:textAllCaps="false"
                android:textColor="@color/vuka_text_inverse"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="27dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
