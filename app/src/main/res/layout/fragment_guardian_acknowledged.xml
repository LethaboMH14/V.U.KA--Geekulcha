<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/vukaBgBase"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="SIMULATED EXAMPLE · NOT A REAL ALERT"
            android:textColor="@color/vuka_text_dim"
            android:textSize="11sp" />

        <!-- The prototype uses a green seal here. Green is reserved for real
             verification (StatusChip.tsx) and nothing is signed yet, so the
             seal is neutral. -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_timeline_node">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_seal_check"
                app:tint="@color/vuka_text_secondary" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:letterSpacing="-0.01"
            android:text="Response recorded"
            android:textColor="@color/vuka_text_title"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Not signed. Device signing isn't built yet."
            android:textColor="@color/vuka_text_secondary"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="TIMELINE · EXAMPLE"
                android:textColor="@color/vuka_text_dim"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/timeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="14dp" />

        <!-- Locked by design: stays disabled until stand-down or closure -->
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:alpha="0.4"
            android:enabled="false"
            android:text="Call them"
            android:textAllCaps="false"
            android:textColor="@color/vuka_text_secondary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="27dp"
            app:icon="@drawable/ic_phone_x"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconTint="@color/vuka_text_secondary"
            app:strokeColor="?attr/vukaBorder"
            app:strokeWidth="1dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="Unlocks after stand-down or when the incident closes. The alert is never withdrawn."
            android:textColor="@color/vuka_text_dim"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToStandby"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/vuka_card_solid"
            android:text="Back to standby"
            android:textAllCaps="false"
            android:textColor="@color/vuka_text_title"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="27dp"
            app:strokeColor="?attr/vukaBorder"
            app:strokeWidth="1dp" />
    </LinearLayout>
</ScrollView>
