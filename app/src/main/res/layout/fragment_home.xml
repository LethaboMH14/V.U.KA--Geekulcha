<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/vukaBgBase"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp">

        <!-- ═══ Home: one layout; the hero card's button toggles Activate / Deactivate ═══ -->
        <LinearLayout
            android:id="@+id/stateReady"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Greeting and name, centred -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true"
                    android:textColor="@color/vuka_text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:accessibilityHeading="true"
                    android:gravity="center"
                    android:letterSpacing="-0.01"
                    android:textColor="@color/vuka_text_title"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Hero: ready to start -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_icon">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:alpha="0.85"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_shield_chevron"
                            app:tint="@color/vuka_text_title" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvVigilLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:letterSpacing="0.1"
                        android:text="VIGIL"
                        android:textColor="@color/vuka_text_dim"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvVigilState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:accessibilityLiveRegion="polite"
                    android:letterSpacing="-0.01"
                    android:text="Ready"
                    android:textColor="@color/vuka_text_title"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <!-- Shown only while Active; drifts (see ListeningLine) -->
                <za.co.vuka.app.ui.home.ListeningLine
                    android:id="@+id/listeningLine"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvVigilBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:text="VIGIL isn't listening yet. Activate it and it will listen on this phone until you deactivate it."
                    android:textColor="@color/vuka_text_secondary"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStart"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_button_primary"
                    app:backgroundTint="@null"
                    android:text="Activate"
                    android:textAllCaps="false"
                    android:textColor="@color/vuka_text_inverse"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="27dp" />
            </LinearLayout>

            <!-- Emergency: one tap records the alert and opens the dialer with 10111.
                 Android still needs a press on call there, so a stray tap can't place a call. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmergency"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:text="Emergency · call 10111"
                android:textAllCaps="false"
                android:textColor="@color/vuka_text_title"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="27dp"
                app:icon="@drawable/ic_phone"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconSize="18dp"
                app:iconTint="@color/vuka_text_title"
                app:strokeColor="@color/vuka_text_title"
                app:strokeWidth="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Opens your dialer with 10111 ready. Press call there."
                android:textColor="@color/vuka_text_dim"
                android:textSize="12sp" />

            <!-- Guardians ready -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_icon">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:alpha="0.85"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_users"
                            app:tint="@color/vuka_text_title" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Guardians ready"
                        android:textColor="@color/vuka_text_title"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvGuardianCounts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/vuka_text_label"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="3dp"
                    android:text="We recommend at least two guardians who don't live with you."
                    android:textColor="@color/vuka_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Only when this phone is also a guardian: the way into Standby.
                 Urgent alerts don't wait for this: they arrive as a notification
                 and a banner on every screen. -->
            <LinearLayout
                android:id="@+id/guardianRoleCard"
                style="@style/Widget.Vuka.SettingsSection"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <include
                    android:id="@+id/rowGuardianRole"
                    layout="@layout/item_settings_row" />
            </LinearLayout>

            <!-- Honest disclosure: a quiet caption, not a card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_microphone"
                    app:tint="@color/vuka_text_dim" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="3dp"
                    android:text="Discreet, not invisible: Android shows a microphone dot while VIGIL is active."
                    android:textColor="@color/vuka_text_dim"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</ScrollView>
