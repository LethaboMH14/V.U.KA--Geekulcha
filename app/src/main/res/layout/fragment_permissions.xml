<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/vukaBgBase"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_back_button"
                android:contentDescription="Back"
                android:padding="13dp"
                android:src="@drawable/ic_caret_left"
                app:tint="@color/vuka_text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="STEP 6 OF 8"
                    android:textColor="@color/vuka_text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:accessibilityHeading="true"
                    android:text="Permissions"
                    android:textColor="@color/vuka_text_title"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="VIGIL needs a few permissions to listen and to reach you."
                android:textColor="@color/vuka_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <include
                android:id="@+id/rowMic"
                layout="@layout/item_permission_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/vukaBorderSubtle" />

            <include
                android:id="@+id/rowNotif"
                layout="@layout/item_permission_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/vukaBorderSubtle" />

            <include
                android:id="@+id/rowLocation"
                layout="@layout/item_permission_row" />
        </LinearLayout>

        <!-- InlineError from shared.tsx: ink outline + icon, never a red border -->
        <LinearLayout
            android:id="@+id/errorContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_input_field_error"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_warning_circle"
                app:tint="@color/vuka_text_title" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:lineSpacingExtra="3dp"
                android:text="Open Settings on this phone and allow microphone and notifications to continue."
                android:textColor="@color/vuka_text_label"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvFullScreenNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Full-screen alerts aren't allowed on this phone. Your Journey check will arrive as a high-priority notification instead."
            android:textColor="@color/vuka_text_dim"
            android:textSize="12sp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_button_primary"
            app:backgroundTint="@null"
            android:text="Continue"
            android:textAllCaps="false"
            android:textColor="@color/vuka_text_inverse"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="27dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenSettings"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="@color/vuka_card_solid"
            android:text="Open settings"
            android:textAllCaps="false"
            android:textColor="@color/vuka_text_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="27dp"
            app:icon="@drawable/ic_gear"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconTint="@color/vuka_text_title"
            app:strokeColor="?attr/vukaBorder"
            app:strokeWidth="1dp" />
    </LinearLayout>
</ScrollView>
