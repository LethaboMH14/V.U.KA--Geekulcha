<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/vukaBgBase"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_back_button"
                android:contentDescription="Back"
                android:padding="13dp"
                android:src="@drawable/ic_caret_left"
                app:tint="@color/vuka_text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="STEP 4 OF 8"
                    android:textColor="@color/vuka_text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:accessibilityHeading="true"
                    android:text="Verify code"
                    android:textColor="@color/vuka_text_title"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="Enter the 6-digit code we sent by SMS."
                android:textColor="@color/vuka_text_secondary"
                android:textSize="15sp" />

            <!-- No SMS provider is wired up yet. Say so on screen rather than
                 let someone wait for a text that never arrives. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:id="@+id/tvCodeNote"
                android:text="SENDING THE CODE…"
                android:textColor="@color/vuka_text_dim"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Where the code goes: shown when the member gave an email as well as a number -->
        <LinearLayout
            android:id="@+id/channelOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/channelSms"
                style="@style/Widget.Vuka.SegmentOption"
                android:layout_marginEnd="4dp"
                android:text="Text message" />

            <TextView
                android:id="@+id/channelEmail"
                style="@style/Widget.Vuka.SegmentOption"
                android:layout_marginStart="4dp"
                android:text="Email" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/codeBoxes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:accessibilityLiveRegion="polite"
            android:focusable="true"
            android:orientation="horizontal">

            <TextView style="@style/Widget.Vuka.CodeBox" />
            <TextView style="@style/Widget.Vuka.CodeBox" />
            <TextView style="@style/Widget.Vuka.CodeBox" />
            <TextView style="@style/Widget.Vuka.CodeBox" />
            <TextView style="@style/Widget.Vuka.CodeBox" />
            <TextView style="@style/Widget.Vuka.CodeBox" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/keypadContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <GridLayout
                android:id="@+id/keypad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-4dp"
                android:layout_marginEnd="-4dp"
                android:columnCount="3">

                <TextView style="@style/Widget.Vuka.KeypadKey" android:text="1" />
                <TextView style="@style/Widget.Vuka.KeypadKey" android:text="2" />
                <TextView style="@style/Widget.Vuka.KeypadKey" android:text="3" />
                <TextView style="@style/Widget.Vuka.KeypadKey" android:text="4" />
                <TextView style="@style/Widget.Vuka.KeypadKey" android:text="5" />
                <TextView style="@style/Widget.Vuka.KeypadKey" android:text="6" />
                <TextView style="@style/Widget.Vuka.KeypadKey" android:text="7" />
                <TextView style="@style/Widget.Vuka.KeypadKey" android:text="8" />
                <TextView style="@style/Widget.Vuka.KeypadKey" android:text="9" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp" />

                <TextView style="@style/Widget.Vuka.KeypadKey" android:text="0" />

                <ImageView
                    android:id="@+id/keyDelete"
                    style="@style/Widget.Vuka.KeypadKey"
                    android:contentDescription="Delete"
                    android:padding="15dp"
                    android:src="@drawable/ic_backspace"
                    app:tint="@color/vuka_text_title" />
            </GridLayout>

            <TextView
                android:id="@+id/tvResend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:minHeight="48dp"
                android:textColor="@color/vuka_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- InlineError from shared.tsx: ink outline + icon, never a red border -->
        <LinearLayout
            android:id="@+id/errorContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_input_field_error"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_warning_circle"
                app:tint="@color/vuka_text_title" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/vuka_text_label"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResend"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="@color/vuka_card_solid"
            android:text="Resend code"
            android:textAllCaps="false"
            android:textColor="@color/vuka_text_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="27dp"
            app:strokeColor="?attr/vukaBorder"
            app:strokeWidth="1dp" />
    </LinearLayout>
</ScrollView>
