<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/vukaBgBase"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_back_button"
                android:contentDescription="Back"
                android:padding="13dp"
                android:src="@drawable/ic_caret_left"
                app:tint="@color/vuka_text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="SIGN IN"
                    android:textColor="@color/vuka_text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:accessibilityHeading="true"
                    android:text="Enter your PIN"
                    android:textColor="@color/vuka_text_title"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_icon">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:alpha="0.85"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/vuka_text_title" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textColor="@color/vuka_text_title"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:text="Your VUKA account is on this phone. Enter your PIN to sign back in."
                android:textColor="@color/vuka_text_secondary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="LOCAL ONLY · ACCOUNTS ON OTHER PHONES CAN'T BE FOUND YET"
                android:textColor="@color/vuka_text_dim"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:text="Enter your PIN"
            android:textColor="@color/vuka_text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/pinDots"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View style="@style/Widget.Vuka.PinDot" />
            <View style="@style/Widget.Vuka.PinDot" />
            <View style="@style/Widget.Vuka.PinDot" />
            <View style="@style/Widget.Vuka.PinDot" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/keypad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-4dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="-4dp"
            android:columnCount="3">

            <TextView style="@style/Widget.Vuka.KeypadKey.Pin" android:text="1" />
            <TextView style="@style/Widget.Vuka.KeypadKey.Pin" android:text="2" />
            <TextView style="@style/Widget.Vuka.KeypadKey.Pin" android:text="3" />
            <TextView style="@style/Widget.Vuka.KeypadKey.Pin" android:text="4" />
            <TextView style="@style/Widget.Vuka.KeypadKey.Pin" android:text="5" />
            <TextView style="@style/Widget.Vuka.KeypadKey.Pin" android:text="6" />
            <TextView style="@style/Widget.Vuka.KeypadKey.Pin" android:text="7" />
            <TextView style="@style/Widget.Vuka.KeypadKey.Pin" android:text="8" />
            <TextView style="@style/Widget.Vuka.KeypadKey.Pin" android:text="9" />

            <Space
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp" />

            <TextView style="@style/Widget.Vuka.KeypadKey.Pin" android:text="0" />

            <ImageView
                android:id="@+id/keyDelete"
                style="@style/Widget.Vuka.KeypadKey.Pin"
                android:contentDescription="Delete"
                android:padding="17dp"
                android:src="@drawable/ic_backspace"
                app:tint="@color/vuka_text_secondary" />
        </GridLayout>

        <TextView
            android:id="@+id/linkDifferentNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="Use a different number"
            android:textColor="@color/vuka_link"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
