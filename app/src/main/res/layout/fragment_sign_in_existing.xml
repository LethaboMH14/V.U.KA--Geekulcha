<?xml version="1.0" encoding="utf-8"?>
<!-- Returning member: sign in with the phone number or the email + password they registered -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/vukaBgBase"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_back_button"
                android:contentDescription="Back"
                android:padding="13dp"
                android:src="@drawable/ic_caret_left"
                app:tint="@color/vuka_text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="WELCOME BACK"
                    android:textColor="@color/vuka_text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:accessibilityHeading="true"
                    android:text="Sign in"
                    android:textColor="@color/vuka_text_title"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPhone"
            style="@style/Widget.Vuka.Button.Option"
            android:layout_marginTop="20dp"
            android:text="Sign in with your phone number"
            app:icon="@drawable/ic_phone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="?attr/vukaBorder" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="or with email"
                android:textColor="@color/vuka_text_dim"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="?attr/vukaBorder" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/Widget.Vuka.FieldLabel"
                android:labelFor="@id/etEmail"
                android:text="Email" />

            <EditText
                android:id="@+id/etEmail"
                style="@style/Widget.Vuka.TextField"
                android:autofillHints="emailAddress"
                android:hint="you@example.co.za"
                android:inputType="textEmailAddress" />

            <TextView
                style="@style/Widget.Vuka.FieldLabel"
                android:layout_marginTop="16dp"
                android:labelFor="@id/etPassword"
                android:text="Password" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/etPassword"
                    style="@style/Widget.Vuka.TextField"
                    android:autofillHints="password"
                    android:inputType="textPassword"
                    android:paddingEnd="52dp" />

                <ImageView
                    android:id="@+id/btnTogglePassword"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginTop="3dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Show password"
                    android:padding="13dp"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/vuka_text_secondary" />
            </FrameLayout>

            <!-- One message for any mismatch: never says which of email or password was wrong -->
            <LinearLayout
                android:id="@+id/errorContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_input_field_error"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="1dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_warning_circle"
                    app:tint="@color/vuka_text_title" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="That email and password don't match an account on this phone."
                    android:textColor="@color/vuka_text_label"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSignIn"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_primary"
                android:text="Sign in"
                android:textAllCaps="false"
                android:textColor="@color/vuka_text_inverse"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="27dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="LOCAL ONLY · ACCOUNTS ON OTHER PHONES CAN'T BE FOUND YET"
                android:textColor="@color/vuka_text_dim"
                android:textSize="10sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="20dp" />

        <TextView
            android:id="@+id/linkCreate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="New to VUKA? Create an account"
            android:textColor="@color/vuka_link"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
