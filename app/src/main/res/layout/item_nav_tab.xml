<?xml version="1.0" encoding="utf-8"?>
<!-- One BottomNav.tsx tab: icon over an uppercase label. Background, icon and
     text colour are set by MainActivity for the active tab. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/ivTabIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        tools:src="@drawable/ic_shield_chevron" />

    <TextView
        android:id="@+id/tvTabLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:letterSpacing="0.06"
        android:textAllCaps="true"
        android:textSize="10sp"
        tools:text="Home" />
</LinearLayout>
