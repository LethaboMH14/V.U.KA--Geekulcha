<?xml version="1.0" encoding="utf-8"?>
<!-- Edit profile: every detail given at sign-up. Same fields as the forms. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <!-- Handle bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_handle_bar" />
        </LinearLayout>

        <!-- Header row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="Edit profile"
                android:textColor="@color/vuka_text_title"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_close_button"
                android:contentDescription="Close"
                android:padding="9dp"
                android:src="@drawable/ic_x"
                app:tint="@color/vuka_text_secondary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="2dp"
            android:text="Guardians see your name on an alert. Keep at least a mobile number or an email so we can reach you."
            android:textColor="@color/vuka_text_secondary"
            android:textSize="14sp" />

        <TextView
            style="@style/Widget.Vuka.FieldLabel"
            android:layout_marginTop="16dp"
            android:labelFor="@id/etFirstName"
            android:text="First name" />

        <EditText
            android:id="@+id/etFirstName"
            style="@style/Widget.Vuka.TextField"
            android:autofillHints="personGivenName"
            android:inputType="textPersonName|textCapWords" />

        <TextView
            style="@style/Widget.Vuka.FieldLabel"
            android:layout_marginTop="16dp"
            android:labelFor="@id/etSurname"
            android:text="Surname" />

        <EditText
            android:id="@+id/etSurname"
            style="@style/Widget.Vuka.TextField"
            android:autofillHints="personFamilyName"
            android:inputType="textPersonName|textCapWords" />

        <TextView
            style="@style/Widget.Vuka.FieldLabel"
            android:layout_marginTop="16dp"
            android:labelFor="@id/etPhone"
            android:text="Mobile number" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_pill"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="+27"
                android:textColor="@color/vuka_text_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPhone"
                style="@style/Widget.Vuka.TextField"
                android:layout_width="0dp"
                android:layout_marginTop="0dp"
                android:layout_weight="1"
                android:autofillHints="phoneNational"
                android:fontFamily="monospace"
                android:hint="82 555 0101"
                android:inputType="number"
                android:maxLength="9" />
        </LinearLayout>

        <TextView
            style="@style/Widget.Vuka.FieldLabel"
            android:layout_marginTop="16dp"
            android:labelFor="@id/etEmail"
            android:text="Email" />

        <EditText
            android:id="@+id/etEmail"
            style="@style/Widget.Vuka.TextField"
            android:autofillHints="emailAddress"
            android:hint="you@example.com"
            android:inputType="textEmailAddress" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="2dp"
            android:text="Saved on this phone. A new number or email isn't verified yet: no SMS or email service is connected in this build."
            android:textColor="@color/vuka_text_dim"
            android:textSize="12sp" />

        <!-- InlineError: ink outline + icon, never a red border -->
        <LinearLayout
            android:id="@+id/errorContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_input_field_error"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_warning_circle"
                app:tint="@color/vuka_text_title" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/vuka_text_label"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_primary"
            app:backgroundTint="@null"
            android:text="Save"
            android:textAllCaps="false"
            android:textColor="@color/vuka_text_inverse"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="27dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
