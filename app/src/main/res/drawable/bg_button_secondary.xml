<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary pill: the card fill with a hairline border and ink text.
     Used for Deactivate, so it reads as the quieter, opposite action. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/vukaBorderEmphasis">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/vukaBgElevated" />
            <stroke
                android:width="1.5dp"
                android:color="@color/vuka_action" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="27dp" />
        </shape>
    </item>
</ripple>
