<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- CodeBoxes (shared.tsx): one mono digit per box. Background swaps to
         bg_input_field_error (ink border) once the box holds a digit. -->
    <style name="Widget.Vuka.CodeBox" parent="">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:gravity">center</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:textColor">@color/vuka_text_title</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- VerifyCode.tsx keypad key, in a 3-column GridLayout -->
    <style name="Widget.Vuka.KeypadKey" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/bg_keypad_key</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/vuka_text_title</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- PinKeypad.tsx: same key, 56dp tall, 20sp digits -->
    <style name="Widget.Vuka.KeypadKey.Pin">
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- PinKeypad.tsx dot; background swaps to bg_pin_dot_filled per digit -->
    <style name="Widget.Vuka.PinDot" parent="">
        <item name="android:layout_width">10dp</item>
        <item name="android:layout_height">10dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_pin_dot_empty</item>
    </style>

    <!-- StatusChip.tsx size="sm": glass pill, neutral grey dot + word -->
    <style name="Widget.Vuka.StatusChip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_chip_pill</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingEnd">9dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">@color/vuka_text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="drawableStartCompat">@drawable/bg_status_dot</item>
    </style>

    <!-- StatusChip status="simulated": mono, uppercase -->
    <style name="Widget.Vuka.StatusChip.Simulated">
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">10sp</item>
    </style>

    <!-- Settings.tsx Section: one glass card per group -->
    <style name="Widget.Vuka.SettingsSection" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@drawable/bg_glass_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">20dp</item>
    </style>

    <style name="Widget.Vuka.SettingsSectionTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/vuka_text_title</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Settings.tsx theme buttons; selected uses bg_input_field_error (ink border) -->
    <style name="Widget.Vuka.SegmentOption" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_tab_inactive</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/vuka_text_label</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Sign-up / sign-in option: white pill, hairline border, icon before the label -->
    <style name="Widget.Vuka.Button.Option" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/vuka_card_solid</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/vuka_text_title</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">27dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">20dp</item>
        <item name="iconTint">@color/vuka_text_title</item>
        <item name="strokeColor">?attr/vukaBorder</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Text field matching bg_input_field; used on the email and password forms -->
    <style name="Widget.Vuka.TextField" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/vuka_text_title</item>
        <item name="android:textColorHint">@color/vuka_text_dim</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.Vuka.FieldLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/vuka_text_label</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
