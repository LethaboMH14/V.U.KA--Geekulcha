<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/welcomeFragment">

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="za.co.vuka.app.ui.onboarding.WelcomeFragment"
        android:label="Welcome"
        tools:layout="@layout/fragment_welcome">

        <action
            android:id="@+id/action_welcome_to_signIn"
            app:destination="@id/signInFragment" />

        <action
            android:id="@+id/action_welcome_to_guardianEnrol"
            app:destination="@id/guardianEnrolFragment" />

        <action
            android:id="@+id/action_welcome_to_standby"
            app:destination="@id/guardianStandbyFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/signInFragment"
        android:name="za.co.vuka.app.ui.onboarding.SignInFragment"
        android:label="Sign In"
        tools:layout="@layout/fragment_sign_in">

        <!-- Every route (Google, email, phone) verifies the number before the profile -->
        <action
            android:id="@+id/action_signIn_to_phoneNumber"
            app:destination="@id/phoneNumberFragment" />

        <action
            android:id="@+id/action_signIn_to_emailSignUp"
            app:destination="@id/emailSignUpFragment" />

        <action
            android:id="@+id/action_signIn_to_document"
            app:destination="@id/documentFragment" />
        <action
            android:id="@+id/action_signIn_to_signInExisting"
            app:destination="@id/signInExistingFragment" />
    </fragment>

    <fragment
        android:id="@+id/emailSignUpFragment"
        android:name="za.co.vuka.app.ui.onboarding.EmailSignUpFragment"
        android:label="Sign up with email"
        tools:layout="@layout/fragment_email_sign_up">

        <action
            android:id="@+id/action_emailSignUp_to_phoneNumber"
            app:destination="@id/phoneNumberFragment" />
    </fragment>

    <fragment
        android:id="@+id/signInExistingFragment"
        android:name="za.co.vuka.app.ui.onboarding.SignInExistingFragment"
        android:label="Sign in"
        tools:layout="@layout/fragment_sign_in_existing">

        <action
            android:id="@+id/action_signInExisting_to_phoneNumber"
            app:destination="@id/phoneNumberFragment" />

        <action
            android:id="@+id/action_signInExisting_to_welcomeBack"
            app:destination="@id/welcomeBackFragment" />
    </fragment>

    <fragment
        android:id="@+id/yourNameFragment"
        android:name="za.co.vuka.app.ui.onboarding.YourNameFragment"
        android:label="Your Name"
        tools:layout="@layout/fragment_your_name">

        <action
            android:id="@+id/action_yourName_to_permissions"
            app:destination="@id/permissionsFragment" />
    </fragment>

    <fragment
        android:id="@+id/phoneNumberFragment"
        android:name="za.co.vuka.app.ui.onboarding.PhoneNumberFragment"
        android:label="Phone Number"
        tools:layout="@layout/fragment_phone_number">

        <action
            android:id="@+id/action_phoneNumber_to_verifyCode"
            app:destination="@id/verifyCodeFragment" />
    </fragment>

    <fragment
        android:id="@+id/verifyCodeFragment"
        android:name="za.co.vuka.app.ui.onboarding.VerifyCodeFragment"
        android:label="Verify Code"
        tools:layout="@layout/fragment_verify_code">

        <!-- A used code is done with: Back from the next step returns to the phone number -->
        <action
            android:id="@+id/action_verifyCode_to_yourName"
            app:destination="@id/yourNameFragment"
            app:popUpTo="@id/verifyCodeFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_verifyCode_to_welcomeBack"
            app:destination="@id/welcomeBackFragment"
            app:popUpTo="@id/verifyCodeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/welcomeBackFragment"
        android:name="za.co.vuka.app.ui.onboarding.WelcomeBackFragment"
        android:label="Welcome Back"
        tools:layout="@layout/fragment_welcome_back">

        <action
            android:id="@+id/action_welcomeBack_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/permissionsFragment"
        android:name="za.co.vuka.app.ui.onboarding.PermissionsFragment"
        android:label="Permissions"
        tools:layout="@layout/fragment_permissions">

        <action
            android:id="@+id/action_permissions_to_setPins"
            app:destination="@id/setPinsFragment" />
    </fragment>

    <fragment
        android:id="@+id/setPinsFragment"
        android:name="za.co.vuka.app.ui.onboarding.SetPinsFragment"
        android:label="Set PINs"
        tools:layout="@layout/fragment_set_pins">

        <action
            android:id="@+id/action_setPins_to_inviteGuardians"
            app:destination="@id/inviteGuardiansFragment" />
    </fragment>

    <fragment
        android:id="@+id/inviteGuardiansFragment"
        android:name="za.co.vuka.app.ui.onboarding.InviteGuardiansFragment"
        android:label="Invite Guardians"
        tools:layout="@layout/fragment_invite_guardians">

        <!-- Onboarding is done: clear it so Back from Home leaves the app -->
        <action
            android:id="@+id/action_inviteGuardians_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="za.co.vuka.app.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_home_to_standby"
            app:destination="@id/guardianStandbyFragment" />
    </fragment>

    <!-- Bottom-nav tabs: Home, Record, Settings (MainActivity) -->
    <fragment
        android:id="@+id/recordFragment"
        android:name="za.co.vuka.app.ui.record.RecordFragment"
        android:label="Record"
        tools:layout="@layout/fragment_record">

        <action
            android:id="@+id/action_record_to_detail"
            app:destination="@id/recordDetailFragment" />
    </fragment>

    <!-- One record's events, view only -->
    <fragment
        android:id="@+id/recordDetailFragment"
        android:name="za.co.vuka.app.ui.record.RecordDetailFragment"
        android:label="Record details"
        tools:layout="@layout/fragment_record_detail" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="za.co.vuka.app.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">

        <action
            android:id="@+id/action_settings_to_document"
            app:destination="@id/documentFragment" />

        <action
            android:id="@+id/action_settings_to_recovery"
            app:destination="@id/recoveryFragment" />

        <action
            android:id="@+id/action_settings_to_guardianEnrol"
            app:destination="@id/guardianEnrolFragment" />

        <action
            android:id="@+id/action_settings_to_standby"
            app:destination="@id/guardianStandbyFragment" />

        <action
            android:id="@+id/action_settings_to_welcome"
            app:destination="@id/welcomeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Where password-reset codes go; PIN recovery is the recovery code (spec §9) -->
    <fragment
        android:id="@+id/recoveryFragment"
        android:name="za.co.vuka.app.ui.settings.RecoveryFragment"
        android:label="Recovery"
        tools:layout="@layout/fragment_recovery" />

    <fragment
        android:id="@+id/documentFragment"
        android:name="za.co.vuka.app.ui.settings.DocumentFragment"
        android:label="Document"
        tools:layout="@layout/fragment_document" />

    <fragment
        android:id="@+id/guardianEnrolFragment"
        android:name="za.co.vuka.app.ui.guardian.EnrolFragment"
        android:label="Guardian Enrol"
        tools:layout="@layout/fragment_guardian_enrol">

        <!-- Enrolled: clear the stack so Back from Standby leaves the app -->
        <action
            android:id="@+id/action_guardianEnrol_to_standby"
            app:destination="@id/guardianStandbyFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />

        <!-- A member enrolling from Settings: drop the finished enrolment, keep their app underneath -->
        <action
            android:id="@+id/action_guardianEnrol_to_standbyKeepMember"
            app:destination="@id/guardianStandbyFragment"
            app:popUpTo="@id/guardianEnrolFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/guardianStandbyFragment"
        android:name="za.co.vuka.app.ui.guardian.StandbyFragment"
        android:label="Guardian Standby"
        tools:layout="@layout/fragment_guardian_standby">

        <action
            android:id="@+id/action_standby_to_alert"
            app:destination="@id/guardianAlertFragment" />

        <action
            android:id="@+id/action_standby_to_welcome"
            app:destination="@id/welcomeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_standby_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_standby_to_signIn"
            app:destination="@id/signInFragment" />
    </fragment>

    <fragment
        android:id="@+id/guardianAlertFragment"
        android:name="za.co.vuka.app.ui.guardian.GuardianAlertFragment"
        android:label="Guardian Alert"
        tools:layout="@layout/fragment_guardian_alert">

        <action
            android:id="@+id/action_guardianAlert_to_acknowledged"
            app:destination="@id/guardianAcknowledgedFragment" />
    </fragment>

    <fragment
        android:id="@+id/guardianAcknowledgedFragment"
        android:name="za.co.vuka.app.ui.guardian.AcknowledgedFragment"
        android:label="Guardian Acknowledged"
        tools:layout="@layout/fragment_guardian_acknowledged" />

</navigation>