<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules for API 23–30. PIN hashes never leave the phone
     (PIN-AUTHORITY-RULES §2), so the interim PIN store is excluded. The saved
     account is excluded with it: restored without its PINs, every PIN gate would fail. -->
<full-backup-content>
    <exclude domain="sharedpref" path="vuka_pin_interim.xml" />
    <exclude domain="sharedpref" path="vuka_password_interim.xml" />
    <exclude domain="sharedpref" path="vuka_account.xml" />
    <exclude domain="sharedpref" path="vuka_record.xml" />
</full-backup-content>
