<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device-transfer rules for API 31+. PIN hashes never leave the
     phone (PIN-AUTHORITY-RULES §2), so the interim PIN store is excluded from both.
     The saved account goes with it: restored without its PINs, every PIN gate would fail. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="vuka_pin_interim.xml" />
        <exclude domain="sharedpref" path="vuka_password_interim.xml" />
        <exclude domain="sharedpref" path="vuka_account.xml" />
        <exclude domain="sharedpref" path="vuka_record.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="vuka_pin_interim.xml" />
        <exclude domain="sharedpref" path="vuka_password_interim.xml" />
        <exclude domain="sharedpref" path="vuka_account.xml" />
        <exclude domain="sharedpref" path="vuka_record.xml" />
    </device-transfer>
</data-extraction-rules>
