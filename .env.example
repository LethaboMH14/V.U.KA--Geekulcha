# Copy this to .env (gitignored) and fill in real values. Never commit .env.
# Load it before running the server, e.g.:
#   set -a; source .env; set +a   (bash)
# or export each line yourself in PowerShell.

# --- Required ---

# A local PostgreSQL instance the server can reach. The server creates its
# own schema on first connect (server/db.py initialize()); no migration step.
DATABASE_URL=postgresql://vuka@127.0.0.1:5432/vuka_dev

# 32 random bytes, base64-encoded. Encrypts every private event payload at
# rest (AES-256-GCM). Generate ONE and keep it — losing it makes every stored
# payload unreadable forever, which is an acceptable and documented trade-off
# for a simulated-data prototype, not for real data.
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
VUKA_PAYLOAD_KEY_B64=

# --- Recommended for local/dev work ---

# Refuses any genesis registration whose subject id does not start with
# sim_. Defaults to "1" (on) if unset, which is almost always what you want
# outside a real deploy. Only set this to 0 if you specifically need to test
# the non-sim path, and never on a shared or public instance.
VUKA_SIM_ONLY=1

# Comma-separated browser origins allowed to call the public, unauthenticated
# GET routes (/healthz, /v1/anchor/latest, /v1/anchor/proof/{head}) via CORS.
# See docs/DASHBOARD-INTEGRATION.md. Unset defaults to common local dev
# ports (Vite/CRA) so a fresh checkout works with zero configuration; set
# this explicitly for a deployed dashboard's real origin. Never use "*".
VUKA_DASHBOARD_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Optional ---

# Turns on the subject-wide contact_lost alarm. Off by default: the app does
# not send heartbeats yet, so this would false-alarm on a phone that is fine.
VUKA_CONTACT_LOST_ENABLED=0

# How often (seconds) the two live WebSocket streams poll the database for
# new chain entries. Lower is snappier for a demo, higher is gentler on the
# database. Default 1.
VUKA_STREAM_POLL_SECONDS=1

# Real guardian push notifications (server/src/notify/fcm.py). With both set,
# server/run_workers.py sends a Firebase push to every guardian who has
# registered a real device token; guardians still on a `sim_` placeholder
# (the app's default, `sim_poll_while_open`) keep in-app delivery. Leave
# either unset to use only the SIMULATED in-app notifier.
# FCM_ACCESS_TOKEN is a short-lived OAuth 2.0 access token (about 1 hour),
# not a service-account key or a legacy server key. When it expires, pushes
# fail with HTTP 401 and alerts fall back to in-app delivery until it is
# refreshed; the worker logs each failed push.
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=

# Where server/run_workers.py sends bank_signal outbox rows. Point this at a
# real `uvicorn sim_bank.main:app` you're running locally (see server/README.md).
# Left at its default, a duress/no_answer/contact_lost bank signal simply
# fails to connect and retries every second until sim_bank is up — this is
# the correct at-least-once behaviour, not a crash.
VUKA_SIM_BANK_URL=http://127.0.0.1:8001

# --- Hedera testnet anchoring (all optional; run_workers.py runs the batch
# coordinator either way) ---

# 0x-prefixed 32-byte secp256k1 private-key hex, from a testnet account you
# control. Without these three, anchor batches are still created from real
# chain heads, but stay unconfirmed (no live sidecar submission) — that is
# the honest state, not an error. See anchor/hedera-sidecar/README.md for how
# to obtain a testnet account and publish the one-time manifest message.
# Never commit these or paste them anywhere but here.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_SUBMIT_KEY=
HEDERA_MANIFEST_SEQUENCE=
