{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vuka.example/contracts/payloads/pin_authorised.v1.json",
  "title": "pin_authorised pv 1 (PROPOSED)",
  "description": "PROPOSED \u00a74b.1 private payload. sig is base64 DER ECDSA P-256 over canonical action, target_id, mode and nonce. Example signature is a simulated shape fixture, not valid authority.",
  "type": "object",
  "required": [
    "kind",
    "pv",
    "action",
    "target_id",
    "mode",
    "nonce",
    "sig",
    "signer_key_id"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "pin_authorised"
    },
    "pv": {
      "const": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "end_journey",
        "export",
        "delete"
      ]
    },
    "target_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "mode": {
      "type": "string",
      "enum": [
        "normal",
        "duress"
      ]
    },
    "nonce": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sig": {
      "type": "string",
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "signer_key_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "examples": [
    {
      "kind": "pin_authorised",
      "pv": 1,
      "action": "export",
      "target_id": "sim_subject",
      "mode": "normal",
      "nonce": "sim_nonce",
      "sig": "MAA=",
      "signer_key_id": "sim_key"
    }
  ]
}
